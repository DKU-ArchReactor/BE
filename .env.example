# Target AWS account: Blank Canvas / 242925688392 (Seoul).
# Copy to .env only after configuring the NEW database and credentials.
APP_NAME=ArchReactor
DEBUG=false
DATABASE_URL=postgresql://archreactor:REPLACE_PASSWORD@REPLACE_NEW_RDS_ENDPOINT:5432/archreactor?sslmode=require
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
CORS_ORIGINS=["http://localhost:5173"]
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=archreactor-artifacts-242925688392-ap-northeast-2
# Local development only. Omit these two variables in Beanstalk (use its IAM role).
AWS_ACCESS_KEY_ID=REPLACE_WITH_NEW_ACCOUNT_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_NEW_ACCOUNT_SECRET_KEY
S3_PRESIGN_EXPIRES_SECONDS=300

# Internal VPC DNS; no CORE implementation is installed in BE.
CORE_GRPC_TARGET=simulator.archreactor.internal:50051
CORE_GRPC_TIMEOUT_SECONDS=12
CORE_RESULT_SCHEMA_MAJOR=1
