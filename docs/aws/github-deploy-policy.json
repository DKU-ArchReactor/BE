{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrLogin",
      "Effect": "Allow",
      "Action": [
        "ecr:GetAuthorizationToken"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PushApplicationImage",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer"
      ],
      "Resource": "arn:aws:ecr:ap-northeast-2:242925688392:repository/capstone/archreactor"
    },
    {
      "Sid": "ReadDeployBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket",
        "s3:GetBucketAcl"
      ],
      "Resource": "arn:aws:s3:::elasticbeanstalk-ap-northeast-2-242925688392"
    },
    {
      "Sid": "UploadApplicationBundle",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:PutObjectAcl",
        "s3:PutObjectVersionAcl"
      ],
      "Resource": "arn:aws:s3:::elasticbeanstalk-ap-northeast-2-242925688392/archreactor/*"
    },
    {
      "Sid": "ReadBeanstalkTemplates",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectAcl",
        "s3:GetObjectVersion",
        "s3:GetObjectVersionAcl"
      ],
      "Resource": [
        "arn:aws:s3:::elasticbeanstalk-ap-northeast-2/environments/*",
        "arn:aws:s3:::elasticbeanstalk-ap-northeast-2-242925688392/*"
      ]
    },
    {
      "Sid": "ReadEnvironments",
      "Effect": "Allow",
      "Action": [
        "elasticbeanstalk:DescribeEnvironments"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RegisterVersion",
      "Effect": "Allow",
      "Action": [
        "elasticbeanstalk:CreateApplicationVersion"
      ],
      "Resource": [
        "arn:aws:elasticbeanstalk:ap-northeast-2:242925688392:application/archreactor",
        "arn:aws:elasticbeanstalk:ap-northeast-2:242925688392:applicationversion/archreactor/*"
      ]
    },
    {
      "Sid": "DeployToEnvironment",
      "Effect": "Allow",
      "Action": [
        "elasticbeanstalk:UpdateEnvironment"
      ],
      "Resource": "arn:aws:elasticbeanstalk:ap-northeast-2:242925688392:environment/archreactor/archreactor-core"
    },
    {
      "Sid": "UpdateBeanstalkStack",
      "Effect": "Allow",
      "Action": [
        "cloudformation:GetTemplate",
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackResource",
        "cloudformation:DescribeStackResources",
        "cloudformation:UpdateStack"
      ],
      "Resource": "arn:aws:cloudformation:ap-northeast-2:242925688392:stack/awseb-e-nygnvhdugs-stack/*"
    },
    {
      "Sid": "ReadDeploymentCapacity",
      "Effect": "Allow",
      "Action": [
        "autoscaling:DescribeAutoScalingGroups"
      ],
      "Resource": "*"
    },
    {
      "Sid": "StageApplicationRuntime",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:PutObjectAcl",
        "s3:GetObjectVersion",
        "s3:GetObjectVersionAcl",
        "s3:PutObjectVersionAcl",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::elasticbeanstalk-ap-northeast-2-242925688392/resources/environments/e-nygnvhdugs/*",
        "arn:aws:s3:::elasticbeanstalk-ap-northeast-2-242925688392/resources/_runtime/_embedded_extensions/archreactor/*"
      ]
    }
  ]
}
